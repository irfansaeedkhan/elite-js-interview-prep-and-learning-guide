{
  "name": "elite-interview-prep-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "velite && concurrently \"velite --watch\" \"next dev\"",
    "dev:clean": "rm -rf .next && velite && concurrently \"velite --watch\" \"next dev\"",
    "build": "velite && next build",
    "start": "next start",
    "lint": "next lint",
    "velite": "velite",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-collapsible": "^1.1.3",
