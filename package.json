    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@tanstack/react-query": "^5.101.2",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.487.0",
    "mermaid": "^11.6.0",
    "next": "^15.3.3",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.2.0",
    "zod": "^4.4.3"
