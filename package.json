    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.8.3",
    "velite": "^0.2.2",
    "vitest": "^4.1.10"
  }
