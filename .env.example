# Copy to .env.local and adjust as needed.
# Local Docker Postgres (see docker-compose.yml):
DATABASE_URL=postgresql://elite:elite_dev_password@localhost:5433/elite_learn

# Better Auth — generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Public app URL (used by auth client in the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — enable Google OAuth when credentials are ready
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
